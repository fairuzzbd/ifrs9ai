# ============================================================================
# BLIPS IFRS9 — Backend environment sample (Phase 0)
# ----------------------------------------------------------------------------
# Salin ke `.env` untuk pengembangan lokal: `cp .env.example .env`
# JANGAN commit `.env` berisi secret asli (lihat security-baseline.md).
# Semua nilai di bawah aman untuk dev dan harus diganti di staging/production.
# ============================================================================

# Port HTTP yang di-bind API server.
SERVER_PORT=8080

# Lingkungan aktif: development | staging | production.
APP_ENV=development

# DSN PostgreSQL 18. Default mengarah ke service postgres docker-compose.dev.yml.
# Gunakan sslmode=require (atau verify-full) di luar development.
DATABASE_URL=postgres://blips_admin:change_me_in_production@localhost:5432/blips_db?sslmode=disable

# URL Redis 7 (Asynq job queue + cache).
REDIS_URL=redis://localhost:6379/0

# MinIO (object storage S3-compatible, DEC-004).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Origin frontend yang diizinkan CORS (comma-separated bila lebih dari satu).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Placeholder JWT Phase 0. Produksi memverifikasi token RSA-2048 dari Keycloak
# (DEC-006/DEC-025); nilai ini wajib di-supply via secrets manager, bukan di-commit.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
