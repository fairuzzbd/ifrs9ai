# EditorConfig — BLIPS IFRS9
# https://editorconfig.org
#
# Stack LOCKED (DEC-001/DEC-002): Go (tabs) + Next.js/TypeScript (2 spaces).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go uses tabs (gofmt)
[*.go]
indent_style = tab

[go.mod]
indent_style = tab

# TypeScript / JavaScript / JSON / YAML — 2 spaces
[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown — keep trailing whitespace (hard line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefiles require real tabs
[Makefile]
indent_style = tab

# SQL
[*.sql]
indent_style = space
indent_size = 2
