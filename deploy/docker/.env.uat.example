# ---------------------------------------------------------------------------
# BLIPS IFRS9 — UAT environment variables example
#
# INSTRUKSI:
#   1. Copy file ini ke .env.uat pada UAT host (JANGAN commit .env.uat).
#   2. Isi semua nilai <set on UAT host, ...> dengan nilai sesungguhnya.
#   3. Simpan .env.uat di luar repo, mis. /opt/blips/secrets/.env.uat
#      dengan chmod 600 dan owner deploy user.
#   4. Jalankan compose dengan --env-file:
#        docker compose -f deploy/docker/docker-compose.uat.yml \
#          --env-file /opt/blips/secrets/.env.uat up -d
#
# SEKURITI: File ini boleh di-commit (hanya contoh).
#            File .env.uat yang berisi nilai asli TIDAK BOLEH di-commit.
#            Lihat security-baseline.md + DEC-028 (encryption at rest).
# ---------------------------------------------------------------------------

# PostgreSQL
# Gunakan password acak minimum 32 karakter alfanumerik.
POSTGRES_PASSWORD=<set on UAT host, never commit>

# MinIO object storage credentials
# MINIO_ROOT_USER: identitas admin MinIO (bukan "minioadmin" default)
MINIO_ROOT_USER=blips_uat_minio
MINIO_ROOT_PASSWORD=<set on UAT host, never commit>

# Keycloak bootstrap admin password
# Hanya untuk initial setup. Setelah realm blips di-import dan admin
# Keycloak permanen dibuat, ubah atau disable akun bootstrap ini.
KC_BOOTSTRAP_ADMIN_PASSWORD=<set on UAT host, never commit>

# Backend JWT public key (RSA-2048 PEM, single-line escaped dengan \n)
# Ambil dari Keycloak setelah up:
#   curl http://localhost:8181/realms/blips/protocol/openid-connect/certs | jq -r '.keys[0]'
#   Atau: bash scripts/keycloak-get-pubkey.sh
# Format: "-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
BLIPS_JWT_PUBLIC_KEY_PEM=<rsa-2048 pem, single-line escaped>

# Backend log level: debug | info | warn | error
BLIPS_LOG_LEVEL=info

# Tenant ID (Phase 1 single-tenant, nilai TUGURE untuk produksi Tugu Re)
BLIPS_TENANT_ID=TUGURE

# ---------------------------------------------------------------------------
# Override optional — defaults sudah cukup untuk UAT on-premise
# ---------------------------------------------------------------------------

# Uncomment dan sesuaikan jika URL backend/frontend berbeda dari default container-internal.
# NEXT_PUBLIC_API_URL=http://api.uat.blips.tugu-re.local
# BLIPS_WEB_ORIGIN=http://uat.blips.tugu-re.local

# JWT issuer URL (default: container-internal Keycloak).
# Set ke URL publik jika Keycloak diakses via Traefik/reverse proxy.
# JWT_ISSUER=http://keycloak.uat.blips.tugu-re.local/realms/blips

# DATABASE_URL dan REDIS_URL dapat di-override jika menggunakan instance
# PostgreSQL / Redis eksternal (bukan container dari compose ini).
# DATABASE_URL=postgres://blips_admin:<password>@<host>:5432/blips_db?sslmode=require
# REDIS_URL=redis://:<password>@<host>:6379/0

# MinIO endpoint override (jika menggunakan MinIO cluster eksternal)
# MINIO_ENDPOINT=minio.uat.blips.tugu-re.local:9000
# MINIO_USE_SSL=true
