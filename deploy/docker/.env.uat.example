# ---------------------------------------------------------------------------
# BLIPS IFRS9 — UAT environment variables example (P5-M18)
#
# INSTRUKSI:
#   1. Copy ke .env.uat pada UAT host (JANGAN commit .env.uat).
#   2. Isi semua nilai <...> dengan nilai sesungguhnya.
#   3. Simpan dengan: chmod 600 /opt/blips/secrets/.env.uat
#   4. Jalankan:
#        docker compose -f deploy/docker/docker-compose.uat.yml \
#          --env-file /opt/blips/secrets/.env.uat up -d
#
# SEKURITI: File ini (example) boleh di-commit (hanya placeholder).
#           .env.uat yang berisi nilai asli TIDAK BOLEH di-commit.
#           Lihat security-baseline.md + DEC-028.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Domain UAT
# ---------------------------------------------------------------------------
UAT_DOMAIN=uat.blips.tugu-re.local

# ---------------------------------------------------------------------------
# PostgreSQL (DEC-003)
# Gunakan password acak minimum 32 karakter alfanumerik.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=<set on UAT host, never commit>

# ---------------------------------------------------------------------------
# Redis (DEC-003)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=<set on UAT host, never commit>

# ---------------------------------------------------------------------------
# MinIO object storage (DEC-004)
# MINIO_ROOT_USER: identitas admin MinIO, jangan pakai "minioadmin" default.
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=blips_uat_minio
MINIO_ROOT_PASSWORD=<set on UAT host, never commit>

# ---------------------------------------------------------------------------
# Keycloak (DEC-006)
# KC_BOOTSTRAP_ADMIN_PASSWORD hanya untuk initial setup.
# Setelah realm blips di-import, disable atau hapus akun bootstrap ini.
# ---------------------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_PASSWORD=<set on UAT host, never commit>

# ---------------------------------------------------------------------------
# JWT (DEC-025)
# RSA-2048 PEM single-line escaped dengan \n.
# Ambil dari Keycloak setelah up:
#   bash scripts/keycloak-get-pubkey.sh
# Format: "-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
# ---------------------------------------------------------------------------
BLIPS_JWT_PUBLIC_KEY_PEM=<rsa-2048 pem, single-line escaped>
JWT_ISSUER=https://uat.blips.tugu-re.local/auth/realms/blips

# ---------------------------------------------------------------------------
# Container image tags (immutable SHA tag wajib — DEC-008 anti-pattern: :latest)
# Set oleh CI pipeline setelah docker build + push ke internal registry.
# ---------------------------------------------------------------------------
BLIPS_BACKEND_IMAGE=registry.tugu-re.local/blips/backend:uat-<sha8>
BLIPS_WORKER_IMAGE=registry.tugu-re.local/blips/worker:uat-<sha8>
BLIPS_FRONTEND_IMAGE=registry.tugu-re.local/blips/frontend:uat-<sha8>

# ---------------------------------------------------------------------------
# Backend application config
# ---------------------------------------------------------------------------
BLIPS_LOG_LEVEL=info
BLIPS_TENANT_ID=TUGURE
NEXT_PUBLIC_API_URL=https://uat.blips.tugu-re.local
BLIPS_WEB_ORIGIN=https://uat.blips.tugu-re.local

# ---------------------------------------------------------------------------
# Override optional — uncomment jika menggunakan DB/Redis/MinIO eksternal
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://blips_admin:<password>@<host>:5432/blips_db?sslmode=require
# DATABASE_REPLICA_URL=postgres://blips_admin:<password>@<replica-host>:5432/blips_db?sslmode=require
# REDIS_URL=redis://:<password>@<host>:6379/0
# MINIO_ENDPOINT=minio.uat.blips.tugu-re.local:9000
# MINIO_USE_SSL=true
