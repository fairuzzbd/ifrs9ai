{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "BLIPS Asynq worker — queue depth, processing rate, failure rate per queue",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Queue Depth",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [{"expr": "sum(asynq_queue_size)", "legendFormat": "", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1000}, {"color": "red", "value": 10000}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Workers",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [{"expr": "sum(asynq_active_workers)", "legendFormat": "", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Job Failure Rate (1h)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [{"expr": "sum(rate(asynq_tasks_failed_total[1h]))", "legendFormat": "", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.01}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Jobs Processed (1h)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [{"expr": "sum(increase(asynq_tasks_processed_total[1h]))", "legendFormat": "", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue Depth per Queue",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [
        {
          "expr": "asynq_queue_size by (queue)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Job Processing Rate per Queue",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [
        {
          "expr": "rate(asynq_tasks_processed_total[5m]) by (queue)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "ECL Calc Run Duration",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(blips_ecl_calc_run_duration_seconds_bucket[30m]) by (le))",
          "legendFormat": "P95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, rate(blips_ecl_calc_run_duration_seconds_bucket[30m]) by (le))",
          "legendFormat": "P50",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Dead Letter Queue (DLQ) Growth",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [
        {
          "expr": "asynq_queue_size{queue=\"dead\"}",
          "legendFormat": "DLQ",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 100}]}}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["blips", "worker", "asynq"],
  "time": {"from": "now-3h", "to": "now"},
  "timezone": "Asia/Jakarta",
  "title": "BLIPS Asynq Jobs",
  "uid": "blips-asynq-jobs",
  "version": 1
}
