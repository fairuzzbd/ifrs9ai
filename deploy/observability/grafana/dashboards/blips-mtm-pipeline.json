{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "BLIPS MTM pipeline — IBPA pricing import, NAV feeds, closing price, FX JISDOR",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last IBPA Import",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [{"expr": "time() - blips_mtm_last_pricing_import_timestamp", "legendFormat": "", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 43200}, {"color": "red", "value": 86400}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last FX JISDOR Import",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [{"expr": "time() - blips_fx_last_import_timestamp", "legendFormat": "", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 43200}, {"color": "red", "value": 86400}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "MTM Import Failures (24h)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [{"expr": "increase(blips_mtm_import_failures_total[24h])", "legendFormat": "", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Instruments with Stale Pricing",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [{"expr": "blips_mtm_stale_pricing_count", "legendFormat": "", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "MTM Import Throughput",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [
        {
          "expr": "rate(blips_mtm_instruments_imported_total[5m])",
          "legendFormat": "Instruments/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "FX Rate Cache Age by Currency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "blips-prometheus"},
      "targets": [
        {
          "expr": "time() - blips_fx_rate_last_update_timestamp by (currency)",
          "legendFormat": "{{currency}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ],
  "refresh": "60s",
  "schemaVersion": 39,
  "tags": ["blips", "mtm", "pipeline"],
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "Asia/Jakarta",
  "title": "BLIPS MTM Pipeline",
  "uid": "blips-mtm-pipeline",
  "version": 1
}
